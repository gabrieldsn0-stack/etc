# Copie este arquivo para .env e preencha.

# Claude (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
# Opcional: modelo e nível de raciocínio (low, medium, high)
MODELO=claude-opus-5-5
ESFORCO=medium

# Dados da clínica (copie clinica.exemplo.json para clinica.json e edite)
ARQUIVO_CLINICA=clinica.json

# Onde fica a agenda: "arquivo" (teste) ou "planilha" (Google Sheets)
AGENDA=arquivo
PLANILHA_ID=1HvtWRnMJNBFIPy1wHRGKqmn4i0YoSHAxq1oJwkXUUeM
PLANILHA_ABA=Agendamentos
GOOGLE_EMAIL_CONTA_SERVICO=
# Cole a chave privada inteira entre aspas, com os \n
GOOGLE_CHAVE_PRIVADA=

# WhatsApp Cloud API (developers.facebook.com -> seu app -> WhatsApp)
WHATSAPP_TOKEN=
WHATSAPP_ID_NUMERO=
WHATSAPP_SEGREDO_APP=
# Uma senha que você inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_TOKEN_VERIFICACAO=
WHATSAPP_VERSAO_API=v24.0

# Quantas horas o agente fica em silêncio depois de transferir para um humano
HORAS_ATENDIMENTO_HUMANO=4
PORT=3000
